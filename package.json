{
  "name": "unreleased-cli",
  "version": "0.1.0",
  "description": "The Unreleased site terminal as a command-line shell",
  "keywords": [
    "juice-wrld",
    "unreleased",
    "cli",
    "terminal",
    "music"
  ],
  "homepage": "https://github.com/Juice-WRLD-API/unreleased-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juice-WRLD-API/unreleased-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Juice-WRLD-API/unreleased-cli/issues"
  },
  "author": "leanwrldd",
  "license": "MIT",
  "type": "module",
  "bin": {
    "unreleased": "dist/unreleased.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/unreleased.mjs",
    "prepack": "node build.mjs",
    "sync": "node scripts/sync-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2"
  }
}
